{
  "info": {
    "_postman_id": "fd1089d9-6ed9-4bcf-87eb-f0c169a63699",
    "name": "Recetas API (Laravel + Sanctum SPA)",
    "description": "Autenticación por cookie de sesión (Sanctum stateful). Ejecuta primero 'Auth > 1. CSRF cookie' y luego 'Auth > 2. Login'. Las rutas /admin requieren usuario admin con email verificado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sanctum SPA: cookie de sesion + cabecera X-XSRF-TOKEN. Origin/Referer deben estar en SANCTUM_STATEFUL_DOMAINS.",
          "let xsrf = pm.cookies.get('XSRF-TOKEN');",
          "if (xsrf) xsrf = decodeURIComponent(xsrf); else xsrf = pm.environment.get('xsrf_token');",
          "if (xsrf) pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrf });",
          "else console.warn('Sin XSRF-TOKEN: ejecuta antes Auth > 1. CSRF cookie');",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Origin', value: pm.environment.get('frontend_url') });",
          "pm.request.headers.upsert({ key: 'Referer', value: pm.environment.get('frontend_url') + '/' });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Guarda el XSRF-TOKEN de cualquier Set-Cookie (Laravel lo renueva tras login/logout).",
          "pm.response.headers.each(h => {",
          "  if (h.key.toLowerCase() !== 'set-cookie') return;",
          "  const m = /^XSRF-TOKEN=([^;]+)/.exec(h.value);",
          "  if (m) pm.environment.set('xsrf_token', decodeURIComponent(m[1]));",
          "});"
        ]
      }
    }
  ],
